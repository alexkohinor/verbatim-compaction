{
  "name": "verbatim-compaction",
  "version": "0.1.0",
  "description": "Rule-based, verbatim context compaction for Claude Code sessions. No model, no network, no API key.",
  "type": "module",
  "license": "MIT",
  "author": "Alex Kohinor (https://github.com/alexkohinor)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexkohinor/verbatim-compaction.git"
  },
  "homepage": "https://github.com/alexkohinor/verbatim-compaction#readme",
  "bugs": {
    "url": "https://github.com/alexkohinor/verbatim-compaction/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "context",
    "compaction",
    "llm",
    "agents",
    "transcript",
    "tokens"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
